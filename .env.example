# ──────────────────────────────────────────────
# Anima MKT CRM — Environment Variables Template
# ──────────────────────────────────────────────
#
# INSTRUCTIONS:
# 1. Copy this file to .env (or .env.local) at the project root.
# 2. Fill in the real values — NEVER commit real credentials.
# 3. Variables prefixed with VITE_ are visible in the browser bundle.
#    NEVER put secrets in VITE_ variables.
# 4. .env, .env.local, .env.production are git-ignored.
# 5. Placeholders use <set-in-netlify> or <set-locally-and-in-netlify> to indicate
#    where the real value must be configured. Never use formats
#    resembling real API keys or secrets.
#
# ──────────────────────────────────────────────

# ─── Application ─────────────────────────────
APP_URL=http://localhost:8888
SUPER_ADMIN_EMAIL=<set-in-netlify>

# ─── MongoDB Atlas ───────────────────────────
MONGODB_URI=<set-in-netlify>
MONGODB_DB_NAME=anima_mkt_crm

# ─── Firebase Admin (server-side only) ───────
FIREBASE_PROJECT_ID=<set-in-netlify>
FIREBASE_CLIENT_EMAIL=<set-in-netlify>
FIREBASE_PRIVATE_KEY=<set-in-netlify>

# ─── Firebase Client (VITE_ = public config, safe to expose) ──
VITE_FIREBASE_API_KEY=<set-locally-and-in-netlify>
VITE_FIREBASE_AUTH_DOMAIN=<set-locally-and-in-netlify>
VITE_FIREBASE_PROJECT_ID=<set-locally-and-in-netlify>
VITE_FIREBASE_APP_ID=<set-locally-and-in-netlify>

# ─── Meta / Facebook (server-side only) ──────
META_APP_ID=<set-in-netlify>
META_APP_SECRET=<set-in-netlify>
META_SYSTEM_USER_TOKEN=<set-in-netlify>
META_BUSINESS_ID=<set-in-netlify>
META_API_VERSION=v26.0
META_VERIFY_TOKEN=<set-in-netlify>
ENABLE_META_LEAD_ADS=false

# ─── Google Cloud / Integrations (server-side only) ──
GOOGLE_CLOUD_PROJECT_ID=<set-in-netlify>
GOOGLE_PLACES_API_KEY=<set-in-netlify>
GOOGLE_CLIENT_ID=<set-in-netlify>
GOOGLE_CLIENT_SECRET=<set-in-netlify>
ENABLE_GOOGLE_INTEGRATIONS=false

# ─── AI (server-side only) ───────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=<set-in-netlify>
GROQ_API_KEY=<set-in-netlify>
ENABLE_AI=false

# ─── Cron / Scheduled Tasks (server-side only) ──
CRON_SECRET=<set-in-netlify>
