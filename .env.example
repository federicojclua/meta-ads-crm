# ──────────────────────────────────────────────
# Cotejo CRM — Environment Variables Template
# ──────────────────────────────────────────────
#
# INSTRUCTIONS:
# 1. Copy this file to .env (or .env.local) at the project root.
# 2. Fill in the real values — NEVER commit real credentials.
# 3. Variables prefixed with VITE_ are visible in the browser bundle.
#    NEVER put secrets in VITE_ variables.
# 4. .env, .env.local, .env.production are git-ignored.
#
# ──────────────────────────────────────────────

# ─── Application ─────────────────────────────
APP_URL=http://localhost:8888
SUPER_ADMIN_EMAIL=your-admin@example.com

# ─── MongoDB Atlas ───────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cotejo_crm

# ─── Firebase Admin (server-side only) ───────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Firebase Client (VITE_ = public, safe) ──
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx

# ─── Meta / Facebook ─────────────────────────
META_APP_ID=000000000000000
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_SYSTEM_USER_TOKEN=EAAG...
META_API_VERSION=v21.0
META_VERIFY_TOKEN=a-random-string-you-choose
ENABLE_META_LEAD_ADS=false

# ─── Google Cloud / Integrations ─────────────
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ENABLE_GOOGLE_INTEGRATIONS=false

# ─── AI (server-side only) ───────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ENABLE_AI=false

# ─── Cron / Scheduled Tasks ─────────────────
CRON_SECRET=a-random-secret-for-cron-endpoints
